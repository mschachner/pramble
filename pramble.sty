%-----Predefined environments-----
% Helper to declare both numbered and unnumbered theorem-like environments
\newcommand{\pramble@declaretheorems}[3]{%
  \newtheorem{#1}{#3}[section]
  \newtheorem{#2}{#3}[section]
  \newtheorem*{#1*}{#3}%
  \newtheorem*{#2*}{#3}%
}

\newcommand{\pramble@declaredefinitions}[3]{%
  \theoremstyle{definition}
  \newtheorem{#1}{#3}[section]
  \newtheorem{#2}{#3}[section]
  \newtheorem*{#1*}{#3}%
  \newtheorem*{#2*}{#3}%
  \theoremstyle{plain}
}

\pramble@declaredefinitions{definition}{definitions}{Definition}
\pramble@declaredefinitions{remark}{remarks}{Remark}
\pramble@declaretheorems{theorem}{theorems}{Theorem}
\pramble@declaretheorems{lemma}{lemmas}{Lemma}
\pramble@declaretheorems{proposition}{propositions}{Proposition}
\pramble@declaretheorems{corollary}{corollaries}{Corollary}
\pramble@declaretheorems{conjecture}{conjectures}{Conjecture}
\pramble@declaretheorems{example}{examples}{Example}
\pramble@declaretheorems{question}{questions}{Question}
\pramble@declaretheorems{fact}{facts}{Fact}
\pramble@declaretheorems{keyidea}{keyideas}{Key Idea}

%-----Customized environments-----

\renewenvironment{proof}[1][\proofname]{\par
  % Inline-QED proof environment: puts the box immediately after the last word
  \normalfont \topsep6\p@\@plus6\p@\relax
  \trivlist
  \item[\hskip\labelsep\itshape #1\@addpunct{.}]\ignorespaces
}{%
  % Append the QED symbol inline (no flush-right box)
  \unskip\nobreak\hspace{.5em}\qedsymbol\endtrivlist\@endpefalse
}

